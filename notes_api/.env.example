# Copy to .env and fill in. Read by notes_api/database.py and, through it, by Alembic.

# Supabase: Project Settings -> Database -> Connection string -> Session pooler.
# Adapt the URI Supabase gives you:
#   - prefix the driver:      postgresql+psycopg://
#   - the user is             postgres.<project-ref>       (not plain "postgres")
#   - the database is         postgres                     (not the project name)
#   - append                  ?sslmode=require
#   - percent-encode reserved characters in the password (@ -> %40, # -> %23)
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Local Postgres instead:
# DATABASE_URL=postgresql+psycopg://localhost:5432/my_notes

# Set to 1 to log every SQL statement.
SQL_ECHO=0
